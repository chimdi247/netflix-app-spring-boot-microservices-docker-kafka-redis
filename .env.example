# Copy to .env to override any default used by docker-compose.yml
# (every value below already has the same default inside the compose file).

# ---- database ------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=root

# application / replication / monitoring accounts are created in docker/mysql/init/02-users.sql and
# configured in docker/proxysql/proxysql.cnf + observability/mysqld-exporter/*.cnf (change them together)

# ---- Redis ---------------------------------------------------------------------
REDIS_PASSWORD=redispass

# ---- authentication ------------------------------------------------------------------
# at least 32 characters; MUST be changed for anything but local use

JWT_SECRET=0c9f1d6a7b3e48c2a5d0e9f4b8a17c63d2e5f60718293a4b5c6d7e8f9a0b1c2d
JWT_TTL_MINUTES=720

# ---- object storage -------------------------------------------------------------------
# Default: MinIO (S3 compatible) started by the compose file.

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
AWS_BUCKET_NAME=netflix-streaming-videos
AWS_REGION=us-east-1

# Address the browser uses for pre-signed video URLs. Change it when you open the app from another machine
# (for example http://192.168.1.20:9000), otherwise playback cannot reach the store.


S3_PUBLIC_ENDPOINT=http://34.171.152.81:9000

#
# To use REAL AWS S3 instead of MinIO: put your IAM keys into S3_ACCESS_KEY / S3_SECRET_KEY, your region and bucket
# above, create the (private) bucket yourself, give it a CORS rule allowing GET from your app's origin, and set:
#   S3_ENDPOINT=
#   S3_PUBLIC_ENDPOINT=
# (empty values switch the services to AWS). The minio containers can then be ignored.

# ---- first start ---------------------------------------------------------------------------
# upload the sample clip for three demo movies after the first start

SEED_DEMO_MOVIES=true
ENCODING_TIMEOUT_MINUTES=120

# ---- Grafana ---------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Grafana-managed alert e-mails (SMTP) ---------------------------------------------------------
# Default: Mailpit, a local catch-all inbox at http://localhost:8025 (no real mail is sent).
# For a real mailbox, e.g. Gmail:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_STARTTLS_POLICY=MandatoryStartTLS
#   SMTP_USER=you@gmail.com   SMTP_PASSWORD=<app password>   SMTP_FROM=you@gmail.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chimdi247@gmail.com
SMTP_PASSWORD=
SMTP_FROM=chimdi247@gmail.com
SMTP_STARTTLS_POLICY=MandatoryStartTLS
SMTP_SKIP_VERIFY=false
ALERT_EMAIL_TO=shimdi247@gmail.com

# ---- image overrides (if a pinned tag is unavailable in your registry) ----------------------------------
# MINIO_IMAGE=elestio/minio:latest
# PROXYSQL_IMAGE=proxysql/proxysql:2.6.2
# MAILPIT_IMAGE=axllent/mailpit:latest
