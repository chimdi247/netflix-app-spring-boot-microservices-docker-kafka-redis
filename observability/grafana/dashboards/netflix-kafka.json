{
  "uid": "netflix-kafka",
  "title": "Netflix Kafka",
  "description": "Kafka broker health, throughput and latency, topics, consumer-group lag and the services that produce and consume.",
  "tags": [
    "netflix",
    "kafka"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "annotations": {
